{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GSA-TTS/agentic-coding-maintainers/workspace-orchestrator-monitor-v1.schema.json",
  "title": "Workspace Orchestrator Monitor Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repositories"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
      }
    },
    "project": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "owner",
        "number"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "owner_type": {
          "description": "Whether project.owner is a GitHub organization or a user. GraphQL exposes projectV2 under separate organization/user root fields with no neutral one, so the type cannot be probed without tolerating an expected NOT_FOUND error \u2014 which would weaken the strict all-errors-are-fatal handling. Optional; absent means organization.",
          "enum": [
            "organization",
            "user"
          ]
        }
      }
    }
  }
}
