{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GSA-TTS/agentic-coding-maintainers/workspace-orchestrator-monitor-v1.schema.json",
  "title": "Workspace Orchestrator Monitor Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}
    },
    "project": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["owner", "number"],
      "properties": {
        "owner": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "number": {"type": "integer", "minimum": 1}
      }
    }
  }
}
