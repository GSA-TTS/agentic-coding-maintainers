esac

case " $* " in
  *" after=page-2 "*)
    if [ "$mode" = "repeated-cursor" ]; then
      page_info='{"hasNextPage":true,"endCursor":"page-2"}'
    else
      page_info='{"hasNextPage":false,"endCursor":null}'
    fi
    printf '{"data":{"node":{"items":{"pageInfo":%s,"nodes":[
  {"content":{"__typename":"Issue","subIssues":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]},"number":999,"title":"Epic: policy consistency","state":"OPEN","url":"https://example/playbook/999","repository":{"nameWithOwner":"GSA-TTS/agentic-coding-playbook"},"labels":{"totalCount":1,"pageInfo":{"hasNextPage":false},"nodes":[{"name":"documentation"}]}},"fieldValues":{"totalCount":1,"pageInfo":{"hasNextPage":false},"nodes":[{"name":"Cancelled","field":{"name":"Status"}}]}},
  {"content":{"__typename":"PullRequest","number":230,"title":"Epic implementation PR","state":"OPEN","url":"https://example/patterns/230","repository":{"nameWithOwner":"GSA-TTS/agentic-coding-patterns"},"labels":{"totalCount":1,"pageInfo":{"hasNextPage":false},"nodes":[{"name":"epic"}]}},"fieldValues":{"totalCount":1,"pageInfo":{"hasNextPage":false},"nodes":[{"name":"Done","field":{"name":"Status"}}]}}
]}}}}
' "$page_info"
    ;;
  *)
    cat <<'JSON'
{"data":{"node":{"items":{"pageInfo":{"hasNextPage":true,"endCursor":"page-2"},"nodes":[
  {"content":{"__typename":"Issue","subIssues":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]},"number":357,"title":"Catalog epic\n\u001b[31mFORGED\ud800\u202e\ue000\u0378","state":"OPEN","url":"https://attacker.invalid/forged","repository":{"nameWithOwner":"GSA-TTS/agentic-coding-patterns"},"labels":{"totalCount":1,"pageInfo":{"hasNextPage":false},"nodes":[{"name":"epic"}]}},"fieldValues":{"totalCount":4,"pageInfo":{"hasNextPage":false},"nodes":[{"name":"In Progress","field":{"name":"Status"}},{"name":"Test","field":{"name":"Work Type"}},{"name":"SBX/Environment","field":{"name":"Area"}},{"name":"Blocked","field":{"name":"Flag"}}]}},
