  missing-subissues)
    printf '{"data":{"node":{"items":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[{"content":{"__typename":"Issue","number":77,"title":"Ordinary issue","state":"OPEN","url":"x","repository":{"nameWithOwner":"GSA-TTS/agentic-coding-patterns"},"labels":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]}},"fieldValues":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]}}]}}}}\n'
    exit 0
    ;;
  contradictory-subissues)
    printf '{"data":{"node":{"items":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[{"content":{"__typename":"Issue","subIssues":{"totalCount":2,"pageInfo":{"hasNextPage":true},"nodes":[]},"number":77,"title":"Ordinary parent","state":"OPEN","url":"x","repository":{"nameWithOwner":"GSA-TTS/agentic-coding-patterns"},"labels":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]}},"fieldValues":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]}}]}}}}\n'
    exit 0
    ;;
  empty)
    printf '{"data":{"node":{"items":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[]}}}}\n'
    exit 0
