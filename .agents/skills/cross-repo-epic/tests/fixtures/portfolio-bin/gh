  no-subissues)
    printf '{"data":{"node":{"items":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[{"content":{"__typename":"Issue","subIssues":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]},"number":77,"title":"Ordinary issue","state":"OPEN","url":"x","repository":{"nameWithOwner":"GSA-TTS/agentic-coding-patterns"},"labels":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]}},"fieldValues":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]}}]}}}}\n'
