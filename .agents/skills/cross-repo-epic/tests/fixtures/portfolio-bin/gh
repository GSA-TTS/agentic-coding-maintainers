    exit 0
    ;;
  bad-page-info)
    printf '{"data":{"node":{"items":{"pageInfo":{},"nodes":[]}}}}\n'
    exit 0
    ;;
  bad-total)
    printf '{"data":{"node":{"items":{"pageInfo":{"hasNextPage":false},"nodes":[{"content":{"__typename":"Issue","subIssues":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]},"number":1,"title":"Epic: bad","state":"OPEN","url":"x","repository":{"nameWithOwner":"GSA-TTS/agentic-coding-patterns"},"labels":{"totalCount":true,"pageInfo":{"hasNextPage":false},"nodes":[]}},"fieldValues":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]}}]}}}}\n'
    exit 0
