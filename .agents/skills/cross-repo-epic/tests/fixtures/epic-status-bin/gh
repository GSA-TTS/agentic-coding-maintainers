  subissue-candidate) title='Ordinary parent issue'; labels='[]'; label_count=0 ;;
  *) title='Epic: catalog work'; labels='[{"name":"epic"}]'; label_count=1 ;;
esac
label_count="${label_count:-1}"

case " $* " in
  *" after=child-page-2 "*)
    child_number=503
    child_repo=GSA-TTS/agentic-coding-quickstart
    total=2
    [ "$mode" = "duplicate-child" ] && child_number=358 && child_repo=GSA-TTS/agentic-coding-patterns
    [ "$mode" = "outside-child" ] && child_repo=other/repo
    [ "$mode" = "changing-total" ] && total=3
    if [ "$mode" = "identity-change" ]; then issue_number=999; else issue_number=357; fi
    if [ "$mode" = "title-change" ]; then title='Epic: changed title'; fi
    cat <<JSON
{"data":{"repository":{"issue":{"__typename":"Issue","number":$issue_number,"title":"$title","state":"OPEN","url":"https://example/patterns/$issue_number","labels":{"totalCount":$label_count,"pageInfo":{"hasNextPage":false,"endCursor":"1"},"nodes":$labels},"subIssues":{"totalCount":$total,"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[{"number":$child_number,"title":"Cross-repo child","state":"OPEN","url":"https://example/child","repository":{"nameWithOwner":"$child_repo"}}]},"projectItems":{"totalCount":1,"pageInfo":{"hasNextPage":false,"endCursor":"1"},"nodes":[{"project":{"id":"PVT_kwDOBbooB84BlPkD","number":120,"title":"Agentic Coding","owner":{"__typename":"Organization","login":"GSA-TTS"}},"fieldValues":{"totalCount":4,"pageInfo":{"hasNextPage":false,"endCursor":"4"},"nodes":[{"name":"In Progress","field":{"name":"Status"}},{"name":"Feature","field":{"name":"Work Type"}},{"name":"SBX/Environment","field":{"name":"Area"}},{"name":"Blocked","field":{"name":"Flag"}}]}}]}}}}}
JSON
    ;;
  *)
    if [ "$mode" = repeated-cursor ]; then next=repeat; else next=child-page-2; fi
    cat <<JSON
{"data":{"repository":{"issue":{"__typename":"Issue","number":357,"title":"$title","state":"OPEN","url":"https://example/patterns/357","labels":{"totalCount":$label_count,"pageInfo":{"hasNextPage":false,"endCursor":"1"},"nodes":$labels},"subIssues":{"totalCount":2,"pageInfo":{"hasNextPage":true,"endCursor":"$next"},"nodes":[{"number":358,"title":"Closed child","state":"CLOSED","url":"https://example/patterns/358","repository":{"nameWithOwner":"GSA-TTS/agentic-coding-patterns"}}]},"projectItems":{"totalCount":1,"pageInfo":{"hasNextPage":false,"endCursor":"1"},"nodes":[{"project":{"id":"PVT_kwDOBbooB84BlPkD","number":120,"title":"Agentic Coding","owner":{"__typename":"Organization","login":"GSA-TTS"}},"fieldValues":{"totalCount":4,"pageInfo":{"hasNextPage":false,"endCursor":"4"},"nodes":[{"name":"In Progress","field":{"name":"Status"}},{"name":"Feature","field":{"name":"Work Type"}},{"name":"SBX/Environment","field":{"name":"Area"}},{"name":"Blocked","field":{"name":"Flag"}}]}}]}}}}}
