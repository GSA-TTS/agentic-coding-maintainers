    printf '{"data":{"repository":{"issue":{"__typename":"Issue","number":357,"title":"Epic: bad","state":"OPEN","url":"x","labels":{"totalCount":1,"pageInfo":{"hasNextPage":false},"nodes":[{"name":"epic"}]},"subIssues":{"totalCount":0,"pageInfo":{"hasNextPage":false},"nodes":[]},"projectItems":{"totalCount":0,"pageInfo":{},"nodes":[]}}}}}\n'
