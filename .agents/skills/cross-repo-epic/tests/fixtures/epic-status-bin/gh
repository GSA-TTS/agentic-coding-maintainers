#!/usr/bin/env sh
mode="${EPIC_STUB_MODE:-success}"
query=''
owner=''
repo=''
number=''
for argument in "$@"; do
  case "$argument" in
    query=*) query="${argument#query=}" ;;
    owner=*) owner="${argument#owner=}" ;;
    repo=*) repo="${argument#repo=}" ;;
    number=*) number="${argument#number=}" ;;
  esac
done
case "$query" in query*) ;; *) printf 'operation does not start with query\n' >&2; exit 1 ;; esac
case "$query" in *mutation*) printf 'mutation is forbidden\n' >&2; exit 1 ;; esac
if [ "$owner" != "GSA-TTS" ] || [ "$repo" != "agentic-coding-patterns" ] || [ "$number" != "357" ]; then
  printf 'wrong owner/repo/number inputs\n' >&2
  exit 1
fi
case "$mode" in
  sleep) sleep 2 ;;
  failure) printf 'query failed\n\033[31mFORGED\u009b' >&2; exit 1 ;;
  malformed) printf 'not json\n'; exit 0 ;;
  errors) printf '{"errors":[{"message":"partial"}],"data":{"repository":{"issue":null}}}\n'; exit 0 ;;
